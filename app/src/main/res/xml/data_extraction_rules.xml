<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Session tokens are device-bound (Keystore-encrypted) and must never be restored elsewhere. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
